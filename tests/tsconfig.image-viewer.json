{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rootDir": "../src",
    "outDir": "../node_modules/.tmp/image-viewer-test"
  },
  "include": [
    "../src/domain/image-viewer.ts",
    "../src/data/species.ts",
    "../src/types/species.ts"
  ]
}
