{
  "name": "fauna-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:taxonomy && npm run test:taxonomy-explorer && npm run test:carousel && npm run test:image-viewer && npm run test:brand-mark && npm run test:species-list && npm run test:dist-subpath",
    "test:taxonomy": "tsc -p tests/tsconfig.taxonomy.json --pretty false && node --test tests/taxonomy.test.mjs",
    "test:taxonomy-explorer": "node --test tests/taxonomy-explorer.test.mjs",
    "test:carousel": "tsc -p tests/tsconfig.carousel.json --pretty false && node --test tests/hero-carousel.test.mjs",
    "test:image-viewer": "tsc -p tests/tsconfig.image-viewer.json --pretty false && node --test tests/image-viewer.test.mjs",
    "test:brand-mark": "node --test tests/brand-mark.test.mjs",
    "test:species-list": "node --test tests/species-list.test.mjs",
    "test:dist-subpath": "npm run build && node --test tests/dist-subpath.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "compress": "node scripts/compress-assets.js",
    "convert:webp": "node scripts/convert-webp.js"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tinify": "^1.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
