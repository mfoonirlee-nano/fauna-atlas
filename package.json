{
  "name": "fauna-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:taxonomy && npm run test:brand-mark && npm run test:dist-subpath",
    "test:taxonomy": "tsc -p tests/tsconfig.taxonomy.json --pretty false && node --test tests/taxonomy.test.mjs",
    "test:brand-mark": "node --test tests/brand-mark.test.mjs",
    "test:dist-subpath": "npm run build && node --test tests/dist-subpath.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
